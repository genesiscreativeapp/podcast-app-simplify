# ===== Compte administrateur =====
# Créé au tout premier démarrage uniquement ; ensuite, les comptes se gèrent dans l'interface (Utilisateurs).
# Si APP_PASSWORD est vide, un mot de passe aléatoire est écrit dans les logs de `web`.
APP_USER=admin
APP_PASSWORD=change-moi

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dossier racine sur R2 : la structure de la plateforme est reproduite en dessous (vide = racine du bucket)
R2_PREFIX=podcasts
# Facultatif : autre stockage compatible S3 (sinon l'adresse Cloudflare R2 du compte)
# R2_ENDPOINT_URL=
# Si le bucket a un domaine public (ex. https://audio.mondomaine.com), les liens seront permanents.
# Sinon : liens signés valables R2_LINK_EXPIRES secondes (7 jours par défaut).
R2_PUBLIC_BASE_URL=

# ===== Détection de la prédication par IA (fortement recommandé) =====
# none | anthropic | openai  (openai = toute API compatible : OpenAI, Groq, OpenRouter, Ollama…)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Uniquement pour LLM_PROVIDER=openai (ex. http://ollama:11434/v1 ou https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.openai.com/v1

# ===== Transcription (CPU) =====
# Passe rapide pour repérer la prédication dans tout le culte : tiny | base | small
WHISPER_MODEL_DETECT=tiny
# Secondes transcrites par fenêtre de 30 s lors du repérage (15 = 2x plus rapide ; 30 = tout)
DETECT_CLIP=15
# Passe précise sur la prédication seule : small | medium (plus lent, plus précis)
WHISPER_MODEL_EDIT=small
WHISPER_LANGUAGE=fr
# Transcriptions en parallèle (défaut : nb de cœurs / 2, max 4) et cœurs par transcription
# WHISPER_WORKERS=2
# WHISPER_THREADS=2
# 1 = rapide (défaut) ; 5 = plus précis mais ~2x plus lent sur la passe mot à mot
WHISPER_BEAM_EDIT=1

# ===== File d'attente =====
# Traitements menés en même temps (modifiable dans l'interface). Les autres attendent en file.
MAX_PARALLEL_JOBS=2

# Durée d'une session de connexion (jours)
SESSION_DAYS=14

# ===== Qualité de la voix =====
# Réduction de bruit en dB : 0 = aucune. Plus c'est fort, plus la voix devient métallique.
DENOISE_DB=6

# ===== Montage =====
MAX_PAUSE=0.8
TARGET_PAUSE=0.45
REMOVE_FILLERS=true
# Fondu de sortie à la fin du podcast (secondes, 0 = coupure nette)
FADE_OUT=2.5
# Secondes lues au-delà de la fin repérée pour terminer sur une fin de phrase (détection automatique sans IA)
END_MARGIN=25
REMOVE_REPEATS=true
# Une répétition est retirée si la pause entre les deux copies est inférieure à (secondes), jusqu'à N mots
REPEAT_MAX_GAP=1.0
REPEAT_MAX_WORDS=8
# Retirer témoignages, annonces, chants, autres voix de la prédication (nécessite LLM_PROVIDER)
REMOVE_OFFTOPIC=true
# Marge (secondes) ajoutée avant/après la prédication repérée : l'IA retire ensuite précisément l'adoration et les annonces
OFFTOPIC_PAD_BEFORE=90
OFFTOPIC_PAD_AFTER=60

# ===== Compression =====
# MP3 mono : 64k ≈ 29 Mo/heure (voix naturelle), 48k ≈ 22 Mo/h, 96k ≈ 43 Mo/h (très fidèle)
MP3_BITRATE=64k
PODCAST_ARTIST=

# ===== YouTube =====
# Si YouTube bloque l'IP du serveur ("Sign in to confirm you're not a bot"),
# exportez vos cookies YouTube dans data/cookies.txt et décommentez :
# YTDLP_COOKIES=/data/cookies.txt

# Format audio demandé à YouTube (léger = téléchargement plus rapide). Pour la meilleure qualité : bestaudio/best
# YTDLP_FORMAT=bestaudio[abr<=70]/bestaudio/best
# Audios YouTube gardés en cache pour qu'un « Relancer » ne les retélécharge pas (0 = aucun)
KEEP_SOURCES=5
# Taille maximale (Mo) d'un fichier audio/vidéo envoyé depuis l'interface
MAX_UPLOAD_MB=4096
# Jours de conservation d'un fichier ajouté à un lot mais jamais lancé (ensuite supprimé du serveur)
STAGING_DAYS=7

# Garder les fichiers intermédiaires (WAV) pour déboguer
KEEP_WORK_FILES=false
