# ===== Accès à l'interface =====
APP_USER=admin
APP_PASSWORD=change-moi

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=podcasts
# Si le bucket a un domaine public (ex. https://audio.mondomaine.com), les liens seront permanents.
# Sinon : liens signés valables R2_LINK_EXPIRES secondes (7 jours par défaut).
R2_PUBLIC_BASE_URL=

# ===== Détection de la prédication par IA (fortement recommandé) =====
# none | anthropic | openai  (openai = toute API compatible : OpenAI, Groq, OpenRouter, Ollama…)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Uniquement pour LLM_PROVIDER=openai (ex. http://ollama:11434/v1 ou https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.openai.com/v1

# ===== Transcription (CPU) =====
# Passe rapide pour repérer la prédication dans tout le culte : tiny | base | small
WHISPER_MODEL_DETECT=tiny
# Secondes transcrites par fenêtre de 30 s lors du repérage (15 = 2x plus rapide ; 30 = tout)
DETECT_CLIP=15
# Passe précise sur la prédication seule : small | medium (plus lent, plus précis)
WHISPER_MODEL_EDIT=small
WHISPER_LANGUAGE=fr
# Transcriptions en parallèle (défaut : nb de cœurs / 2, max 4) et cœurs par transcription
# WHISPER_WORKERS=2
# WHISPER_THREADS=2
# 1 = rapide (défaut) ; 5 = plus précis mais ~2x plus lent sur la passe mot à mot
WHISPER_BEAM_EDIT=1

# ===== File d'attente =====
# Traitements menés en même temps (modifiable dans l'interface). Les autres attendent en file.
MAX_PARALLEL_JOBS=2

# ===== Montage =====
MAX_PAUSE=0.8
TARGET_PAUSE=0.45
REMOVE_FILLERS=true
REMOVE_REPEATS=true

# ===== Compression =====
# MP3 mono 22 kHz : 40k ≈ 18 Mo/heure, 48k ≈ 22 Mo/h (meilleure qualité), 32k ≈ 14 Mo/h
MP3_BITRATE=40k
PODCAST_ARTIST=

# ===== YouTube =====
# Si YouTube bloque l'IP du serveur ("Sign in to confirm you're not a bot"),
# exportez vos cookies YouTube dans data/cookies.txt et décommentez :
# YTDLP_COOKIES=/data/cookies.txt

# Format audio demandé à YouTube (léger = téléchargement plus rapide). Pour la meilleure qualité : bestaudio/best
# YTDLP_FORMAT=bestaudio[abr<=70]/bestaudio/best
# Audios YouTube gardés en cache pour qu'un « Relancer » ne les retélécharge pas (0 = aucun)
KEEP_SOURCES=5

# Garder les fichiers intermédiaires (WAV) pour déboguer
KEEP_WORK_FILES=false
